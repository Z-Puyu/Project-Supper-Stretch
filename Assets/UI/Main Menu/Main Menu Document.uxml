<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Style%20Sheets/Main%20Menu%20Style%20Sheet.uss?fileID=7433441132597879392&amp;guid=b7a15f6635055874b924d086b16e3656&amp;type=3#Main Menu Style Sheet" />
    <ui:VisualElement name="Background" style="flex-grow: 1; align-content: auto; align-items: stretch; align-self: auto; justify-content: space-between; background-color: rgb(0, 0, 0);">
        <ui:Label text="Project: Supper Stretch" name="GameTitle" class="title" style="justify-content: flex-start; align-items: stretch; margin-top: 15%;" />
        <ui:Button text="Press Any Key to Start" name="StartButton" enabled="true" focusable="false" class="button" style="display: flex; margin-bottom: 15%;" />
        <ui:VisualElement name="Buttons" style="flex-grow: 0; align-items: stretch; justify-content: flex-start; align-self: center; align-content: flex-start; display: none; margin-bottom: 15%; visibility: visible;">
            <ui:Button text="New Game" name="NewGameButton" class="button" />
            <ui:Button text="Quit Game" name="QuitGameButton" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
